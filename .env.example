# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding and LLM Model Configurations
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_DIMENSION=768
GENERATION_MODEL_NAME=gemini-3.5-flash-lite
MAX_CONTEXT_CHARACTERS=12000

# Default RAG Parameters
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_TOP_K=5
DEFAULT_RETRIEVAL_MODE=semantic
DEFAULT_MIN_SIMILARITY=0.50

# Advanced RAG Configurations (Optional)
RERANKER_ENABLED=false
QUERY_EXPANSION_ENABLED=false
PARENT_CHILD_ENABLED=false
CONTEXT_COMPRESSION_ENABLED=false
COMPRESSION_MAX_SENTENCES=7
COMPRESSION_SIMILARITY_THRESHOLD=0.05
